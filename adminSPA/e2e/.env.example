# Copie a e2e/.env (no commitear .env con contraseñas reales)
E2E_API_URL=http://127.0.0.1:3000
E2E_BASE_URL=http://127.0.0.1:4200

# Empresa gestora (mismo flujo que login en pantalla)
E2E_GESTORA_RUC=20123456789
E2E_GESTORA_EMAIL=admin@empresa.com
E2E_GESTORA_PASSWORD=su_clave

# Opcional: forzar una VA pendiente concreta (si vacío, toma la primera del listado)
# E2E_ID_VENTA_AGRUPADA=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Si es 1, solo lista pendientes y valida contexto; no ejecuta POST /cobrar
E2E_DRY_RUN=0
