# Backend (monorepo: solo adminSPA tenía .gitignore)
backAppC/node_modules/

# Logs y depuración local
*.log
debug-*.log

# Scripts de parche locales (no subir)
backAppC/scripts/_*.js
backAppC/utils/bash_write_test.txt

# Cursor
.cursor/

# Variables de entorno locales (no subir valores reales)
.env
.env.local
.env.production
.env.development
**/.env.local
# Backend: credenciales (explícito; si ya se subió antes, ejecutar: git rm --cached backAppC/.env)
backAppC/.env

# Plantillas SIN secretos: sí se versionan (p. ej. backAppC/.env.example)
