# Solo localhost (no exponer a internet; igual que pdf-backend)
HOST=127.0.0.1
PORT=3010
GATEWAY_API_KEY=cambiar-clave-secreta-larga
SESSIONS_DIR=./sessions
LOG_LEVEL=warn
# Intervalo minimo entre envios (ms). 400 suele ser suficiente para respuestas del bot.
SEND_MIN_INTERVAL_MS=400
QR_WAIT_MS=30000

# Webhook entrante hacia backAppC (Piloto A)
BACKEND_WEBHOOK_URL=http://127.0.0.1:3000/api/whatsapp-bot/inbound
WEBHOOK_SECRET=misma-clave-que-WHATSAPP_BOT_WEBHOOK_SECRET-en-backAppC
# Debe ser mayor que el tiempo maximo de procesamiento del backend (cotizacion/PDF puede tardar).
WEBHOOK_TIMEOUT_MS=90000
