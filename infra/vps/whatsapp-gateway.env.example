# whatsapp-gateway — VPS (copiar a whatsapp-gateway/.env)
# cp infra/vps/whatsapp-gateway.env.example whatsapp-gateway/.env

HOST=127.0.0.1
PORT=3010
GATEWAY_API_KEY=GENERAR_CON_openssl_rand_hex_32
SESSIONS_DIR=./sessions
LOG_LEVEL=warn
SEND_MIN_INTERVAL_MS=400
QR_WAIT_MS=30000

BACKEND_WEBHOOK_URL=http://127.0.0.1:3000/api/whatsapp-bot/inbound
WEBHOOK_SECRET=GENERAR_MISMO_VALOR_QUE_WHATSAPP_BOT_WEBHOOK_SECRET
WEBHOOK_TIMEOUT_MS=90000

GATEWAY_ALLOW_REMOTE_MEDIA=0
GATEWAY_MAX_MEDIA_BYTES=52428800
