# pdf-backend — VPS (copiar a pdf-backend/.env)
# cp infra/vps/pdf-backend.env.example pdf-backend/.env

NODE_ENV=production
PORT=3002

# Solo loopback: el navegador llega vía Nginx /api/reports → backAppC no expone 3002
PDF_BACKEND_BIND_HOST=127.0.0.1

# Mismo valor que PDF_BACKEND_TOKEN en backAppC/.env
PDF_BACKEND_TOKEN=GENERAR_CON_openssl_rand_hex_32

# Exigir token incluso desde loopback (recomendado en VPS)
PDF_BACKEND_REQUIRE_TOKEN=true

FRONTEND_URL=https://tudominio.com
CORS_EXTRA_ORIGINS=https://www.tudominio.com
CORS_ALLOW_LAN=0
