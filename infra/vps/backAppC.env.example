# =============================================================================
# backAppC — VPS internet (copiar a backAppC/.env en el servidor)
# cp infra/vps/backAppC.env.example backAppC/.env
# =============================================================================

NODE_ENV=production
PORT=3000

# --- SQL Server ---
# Si SQL está en el MISMO VPS: DB_SERVER=127.0.0.1 (no 0.0.0.0 en SQL).
# Si SQL está en otro host: IP privada o VPN; firewall solo desde IP del VPS.
DB_SERVER=127.0.0.1
DB_NAME=nombre_base_datos
DB_USER=usuario_app_sin_sa
DB_PASSWORD=cambiar_password_fuerte
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=false

# --- JWT (obligatorio en production) ---
JWT_SECRET=GENERAR_CON_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_MINUTES=240
JWT_2FA_PENDING_MINUTES=10
JWT_REFRESH_EXPIRES_DAYS=7

# --- URLs públicas (HTTPS) ---
FRONTEND_URL=https://tudominio.com
API_BASE_URL=https://tudominio.com
CORS_EXTRA_ORIGINS=https://www.tudominio.com
# En internet: NO aceptar redes privadas 192.168.x / 10.x por defecto
CORS_ALLOW_LAN=0

# --- Proxy Nginx ---
TRUST_PROXY=1
HEALTH_CHECK_DB=1

# --- Redis (opcional) ---
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DASHBOARD_TTL_SECONDS=180

# --- Integraciones ---
FACTILIZA_TOKEN=
APISPERU_TOKEN=

# --- Correo ---
SMTP_HOST=smtp.tuproveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EFAF <noreply@tudominio.com>"
SMTP_IPV4=true

PASSWORD_RECOVERY_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RECOVERY_RATE_LIMIT_MAX=8
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=20

# --- Twilio (opcional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Cifrado certificados SUNAT en BD
CERT_ENCRYPTION_KEY=GENERAR_CON_openssl_rand_hex_32

DEPLOYMENT_MODE=enterprise
EMPRESA_PRINCIPAL_ID=

# --- pdf-backend (solo loopback en el mismo VPS) ---
PDF_BACKEND_URL=http://127.0.0.1:3002
PDF_BACKEND_TIMEOUT_MS=90000
PDF_BACKEND_TOKEN=GENERAR_CON_openssl_rand_hex_32

# --- Login / seguridad ---
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
MFA_RATE_LIMIT_WINDOW_MS=900000
MFA_RATE_LIMIT_MAX=10

ALERT_DEV_WHATSAPP=
ALERT_SYSTEM_THROTTLE_MS=900000
ALERT_DEV_CACHE_TTL_MS=300000
ALERT_DEV_EMAIL=admin@tudominio.com

SPRAYING_VENTANA_MS=900000
SPRAYING_MIN_EMAILS=5
SPRAYING_MIN_INTENTOS=10
SPRAYING_THROTTLE_MS=1800000
INYECCION_ALERT_THROTTLE_MS=300000

FACTILIZA_HEALTHCHECK_INTERVAL_MS=21600000
FACTILIZA_WHATSAPP_DOWN_THRESHOLD=3
FACTILIZA_WHATSAPP_DOWN_EMAIL_THROTTLE_MS=3600000

ONBOARDING_AUTOMATION_INTERVAL_MS=3600000
DEBUG_FACTURADOR=

# --- WhatsApp Gateway (solo localhost; Nginx NO debe proxyar :3010) ---
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3010
WHATSAPP_GATEWAY_API_KEY=GENERAR_MISMO_VALOR_QUE_GATEWAY_API_KEY
WHATSAPP_GATEWAY_TIMEOUT_MS=60000

WHATSAPP_BOT_WEBHOOK_SECRET=GENERAR_MISMO_VALOR_QUE_WEBHOOK_SECRET_EN_GATEWAY
WHATSAPP_BOT_WEBHOOK_ALLOW_IPS=127.0.0.1,::1,::ffff:127.0.0.1
WHATSAPP_BOT_WEBHOOK_SKIP_IP_CHECK=
WHATSAPP_BOT_COTIZ_MAX_DIA=3
WHATSAPP_BOT_PEDIDO_PDF_MAX_DIA=3
