# Base de datos (SQL Server)
DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true

# JWT - OBLIGATORIO en producción: definir JWT_SECRET fuerte (ej. 64 caracteres aleatorios)
# No dejar por defecto en producción
JWT_SECRET=

# API externa ApisPeru (DNI/RUC) - usado por el proxy /api/external/dni y /api/external/ruc
APISPERU_TOKEN=

# Frontend (CORS y redirecciones)
FRONTEND_URL=http://localhost:4200

# Servidor
PORT=3000
NODE_ENV=development

# Opcional: URL base de la API para links en PDFs/emails
API_BASE_URL=http://localhost:3000

# Opcional: Factiliza (consultas RUC/DNI/otros)
FACTILIZA_TOKEN=

# Cifrado de claves de certificado y SOL (Facturación electrónica).
# Requerido si en Configuración > Facturación se guardan claves cifradas. Debe ser la misma en todos los servidores que usen la misma BD.
CERT_ENCRYPTION_KEY=Erik@.123

# Opcional: SMTP (recuperar/restablecer contraseña)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Plataforma: listado global de empresas (/api/empresa) y reset 2FA masivo.
# Solo usuarios con rol superAdmin y JWT empresa = este UUID (empresa principal / desarrollador).
# En desarrollo puede dejarse vacío: entonces solo se exige superAdmin.
EMPRESA_PRINCIPAL_ID=

# Opcional: Redis (cache dashboard y otros). Si no se define, la app no usa cache.
# REDIS_URL=redis://localhost:6379
# O por partes:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# TTL del cache del dashboard (segundos, 2-5 min recomendado)
# REDIS_DASHBOARD_TTL_SECONDS=180
