# =============================================================================
# backAppC — variables de entorno (copiar a ".env" y rellenar; NO subir .env)
# =============================================================================

NODE_ENV=development
PORT=3000

# --- SQL Server (obligatorio en la mayoría de entornos) ---
DB_SERVER=localhost
DB_NAME=tu_base
DB_USER=sa
DB_PASSWORD=cambiar
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=true

# --- JWT (obligatorio si NODE_ENV=production) ---
# En desarrollo, si queda vacío, el backend usa un fallback inseguro solo local (ver jwt.config.js).
JWT_SECRET=cambiar-por-cadena-larga-aleatoria-minimo-32-caracteres
JWT_ACCESS_EXPIRES_MINUTES=240
JWT_2FA_PENDING_MINUTES=10
JWT_REFRESH_EXPIRES_DAYS=7

# --- CORS / URLs públicas ---
FRONTEND_URL=http://localhost:4200
API_BASE_URL=http://localhost:3000
# Orígenes extra (coma). Ej.: front desde otra PC: http://192.168.1.50:4200
CORS_EXTRA_ORIGINS=
# En production: vacio o "0" => solo lista explicita (FRONTEND_URL + CORS_EXTRA_ORIGINS).
# Si necesitas que en production tambien se acepten origenes RFC1918 (10/172/192.168)
# y *.local, define explicitamente CORS_ALLOW_LAN=1 (opt-in, queda registrado en log).
# En desarrollo: vacio => LAN permitida; pon "0" para forzar comportamiento prod.
CORS_ALLOW_LAN=

# --- Redis (opcional; caché dashboard, etc.) ---
# Usar REDIS_URL O bien REDIS_HOST (+ opcional REDIS_PASSWORD).
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DASHBOARD_TTL_SECONDS=180

# --- Integraciones / tokens (nunca commitear valores reales) ---
FACTILIZA_TOKEN=
APISPERU_TOKEN=

# --- Correo (recuperación de contraseña, notificaciones) ---
# Gmail: crear "contraseña de aplicación" en la cuenta Google; SMTP_PASS con espacios entre comillas.
# Ej.: SMTP_FROM="Mi App <noreply@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Si la conexión al SMTP da timeout (p. ej. solo intenta IPv6), probar: SMTP_IPV4=true
SMTP_IPV4=
# Límites por IP (express-rate-limit) sobre recuperar/restablecer contraseña
PASSWORD_RECOVERY_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RECOVERY_RATE_LIMIT_MAX=8
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=20

# --- Twilio WhatsApp (opcional; también puede configurarse por BD) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Cifrado de claves de certificado digital en BD ---
CERT_ENCRYPTION_KEY=

# --- Plataforma / SaaS ---
# saas = gate de suscripción y límites de plan; enterprise = instalación sin EmpresaSuscripcion (p. ej. otra BD legacy).
DEPLOYMENT_MODE=enterprise
EMPRESA_PRINCIPAL_ID=

# --- Webhooks Culqi / Izipay (POST /api/webhooks/culqi | /izipay) ---
# Secreto compartido: header X-Pasarela-Webhook-Secret o ?webhook_secret= en la URL del panel.
PASARELA_WEBHOOK_SECRET=
CULQI_WEBHOOK_SECRET=
IZIPAY_WEBHOOK_SECRET=
# Solo desarrollo: omitir validación (NO usar en production)
WEBHOOK_SKIP_SIGNATURE_VERIFY=

# --- Proxy / salud ---
TRUST_PROXY=0
HEALTH_CHECK_DB=0

# --- pdf-backend (servicio Excel/PDF en :3002) ---
PDF_BACKEND_URL=http://127.0.0.1:3002
PDF_BACKEND_TIMEOUT_MS=90000
# Debe coincidir con PDF_BACKEND_TOKEN en pdf-backend/.env. Si queda vacío
# y pdf-backend está en loopback, igualmente acepta. En producción configurar
# obligatoriamente un valor aleatorio largo.
PDF_BACKEND_TOKEN=

# --- Login / alertas ---
# Limite por ventana de tiempo (IP+email) para POST /api/admin_login.
# 5 intentos / 15 min recomendado para mitigar credential stuffing.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
# Limite para los endpoints 2FA (admin_2fa_*). IP+pendingToken.
MFA_RATE_LIMIT_WINDOW_MS=900000
MFA_RATE_LIMIT_MAX=10
# El numero destino de las alertas (3+ fallos por mismo email/empresa, email-
# spraying, payloads sospechosos, replay de refresh, errores internos, lockout,
# ping Factiliza, login superAdmin) se obtiene automaticamente decodificando
# FactilizaConfig.parametroRuta de la fila "Factiliza WHATSAPP". Si quieres
# redirigir a un numero distinto (p.ej. on-call diferente del bot), define
# ALERT_DEV_WHATSAPP aqui (override).
ALERT_DEV_WHATSAPP=
ALERT_SYSTEM_THROTTLE_MS=900000
# Cache TTL del numero del dev resuelto desde BD (default 5 min).
ALERT_DEV_CACHE_TTL_MS=300000
# Email de respaldo si Factiliza WhatsApp se cae N veces seguidas. Si vacío, usa
# SMTP_USER. Si tampoco está, no envía email pero queda log JSON estructurado.
ALERT_DEV_EMAIL=

# --- Detección de credential stuffing / email spraying ---
# Si una IP acumula >=SPRAYING_MIN_INTENTOS fallos contra >=SPRAYING_MIN_EMAILS
# emails distintos en SPRAYING_VENTANA_MS, dispara alerta al dev (con throttle).
SPRAYING_VENTANA_MS=900000
SPRAYING_MIN_EMAILS=5
SPRAYING_MIN_INTENTOS=10
SPRAYING_THROTTLE_MS=1800000

# --- Detección de payloads de inyección ---
# Throttle por IP cuando se detecta SQLi/XSS/path-traversal/template-injection
# en el body de /admin_login.
INYECCION_ALERT_THROTTLE_MS=300000

# --- Health-check Factiliza WhatsApp ---
# Ping silencioso cada N ms (default 6h). Si el envío real falla
# FACTILIZA_WHATSAPP_DOWN_THRESHOLD veces consecutivas, dispara aviso por email.
FACTILIZA_HEALTHCHECK_INTERVAL_MS=21600000
FACTILIZA_WHATSAPP_DOWN_THRESHOLD=3
FACTILIZA_WHATSAPP_DOWN_EMAIL_THROTTLE_MS=3600000

# --- Jobs ---
ONBOARDING_AUTOMATION_INTERVAL_MS=3600000

# --- Depuración ---
DEBUG_FACTURADOR=

# --- WhatsApp Gateway (Baileys microservicio, puerto 3010) ---
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3010
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_GATEWAY_TIMEOUT_MS=60000

# --- Bot WhatsApp entrante (Piloto A: gateway -> backend) ---
# Misma clave que WEBHOOK_SECRET en whatsapp-gateway/.env
WHATSAPP_BOT_WEBHOOK_SECRET=
# Solo localhost (gateway interno). Coma-separado. En dev LAN: WHATSAPP_BOT_WEBHOOK_SKIP_IP_CHECK=true
WHATSAPP_BOT_WEBHOOK_ALLOW_IPS=127.0.0.1,::1,::ffff:127.0.0.1
WHATSAPP_BOT_WEBHOOK_SKIP_IP_CHECK=
# Maximo cotizaciones por dia por numero/cliente
WHATSAPP_BOT_COTIZ_MAX_DIA=3
# Maximo PDF de pedidos por dia por numero (bot WhatsApp)
WHATSAPP_BOT_PEDIDO_PDF_MAX_DIA=3

# Lista Excel/PDF en cotización WhatsApp (tamaño máx. enviado al pdf-backend)
WHATSAPP_BOT_MAX_ATTACHMENT_BYTES=4194304
WHATSAPP_BOT_LISTA_MAX_FILAS=200

# Fase B: primera sync de catalogo al primer mensaje si el indice esta vacio
