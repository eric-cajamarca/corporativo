# pdf-backend — copiar a ".env" si se usan variables (opcional)
PORT=3002

# Por defecto el servicio se publica solo en loopback (127.0.0.1) para que
# solo lo consuma backAppC. Cambia este valor a 0.0.0.0 únicamente si vas a
# exponerlo en otra interfaz y configuras un token estricto abajo.
PDF_BACKEND_BIND_HOST=127.0.0.1

# Token compartido con backAppC. Debe coincidir con el PDF_BACKEND_TOKEN que
# se ponga en backAppC/.env. Si se deja vacío, pdf-backend acepta solo
# peticiones desde la propia máquina (loopback).
PDF_BACKEND_TOKEN=

# Si =true, exige token incluso desde loopback (recomendado en producción).
PDF_BACKEND_REQUIRE_TOKEN=false

# Misma URL que usan los navegadores con Nginx (sin puerto si es :80), p. ej. http://192.168.1.47
FRONTEND_URL=

# Orígenes extra separados por coma (opcional)
# CORS_ORIGIN=http://sistema.local,http://192.168.1.47

# CORS_ALLOW_LAN=0  → desactiva aceptación automática de orígenes en LAN privada
